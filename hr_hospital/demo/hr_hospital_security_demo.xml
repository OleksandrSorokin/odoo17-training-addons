<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="hr_hospital_demo_user_patient" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Demo Hospital Patient</field>
        <field name="login">demo.patient@hospital.invalid</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('hr_hospital.group_hospital_patient')])]"/>
    </record>
    <record id="hr_hospital_demo_user_intern" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Demo Hospital Intern</field>
        <field name="login">demo.intern@hospital.invalid</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('hr_hospital.group_hospital_intern')])]"/>
    </record>
    <record id="hr_hospital_demo_user_doctor" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Demo Hospital Doctor</field>
        <field name="login">demo.doctor@hospital.invalid</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('hr_hospital.group_hospital_doctor')])]"/>
    </record>
    <record id="hr_hospital_demo_user_manager" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Demo Hospital Manager</field>
        <field name="login">demo.manager@hospital.invalid</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('hr_hospital.group_hospital_manager')])]"/>
    </record>
    <record id="hr_hospital_demo_user_admin" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Demo Hospital Administrator</field>
        <field name="login">demo.admin@hospital.invalid</field>
        <field name="groups_id" eval="[(6, 0, [ref('base.group_user'), ref('hr_hospital.group_hospital_admin')])]"/>
    </record>
    <function model="hr.hospital.patient" name="write"
              eval="[[ref('hr_hospital_patient_demo_1')], {'user_id': ref('hr_hospital_demo_user_patient')}]"/>
    <function model="hr.hospital.doctor" name="write"
              eval="[[ref('hr_hospital_doctor_demo_3')], {'user_id': ref('hr_hospital_demo_user_intern')}]"/>
    <function model="hr.hospital.doctor" name="write"
              eval="[[ref('hr_hospital_doctor_demo_1')], {'user_id': ref('hr_hospital_demo_user_doctor')}]"/>
</odoo>
