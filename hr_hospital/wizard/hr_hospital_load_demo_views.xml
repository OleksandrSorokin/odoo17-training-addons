<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_load_demo_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.load.demo.wizard.form</field>
        <field name="model">hr.hospital.load.demo.wizard</field>
        <field name="arch" type="xml">
            <form string="Load Hospital Demo Data">
                <div class="alert alert-warning" role="alert">
                    Training database only. Demo records, sample users, and a fictional
                    demo company will be created. Existing fixture sets are skipped.
                    No default passwords are assigned to demo users.
                </div>
                <footer>
                    <button name="action_load_demo" type="object" string="Load Demo Data"
                            context="{'hospital_confirm_demo': True}" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="hr_hospital_load_demo_action" model="ir.actions.act_window">
        <field name="name">Load Hospital Demo Data</field>
        <field name="res_model">hr.hospital.load.demo.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_hospital_load_demo_view_form"/>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('hr_hospital.group_hospital_admin'))]"/>
    </record>
</odoo>
