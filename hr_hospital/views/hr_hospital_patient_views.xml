<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_patient_view_tree" model="ir.ui.view">
        <field name="name">hr.hospital.patient.view.tree</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="age"/>
                <field name="doctor_id"/>
                <field name="phone"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_patient_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.view.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <button name="action_schedule_visit" type="object"
                            string="Schedule Visit" class="btn-primary"/>
                    <button name="action_show_visits" type="object" string="Visit History"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <group>
                        <group string="Personal Information">
                            <field name="name"/>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age" readonly="1"/>
                        </group>
                        <group string="Contact Information">
                            <field name="phone"/>
                            <field name="doctor_id"/>
                            <field name="contact_person_id"/>
                            <field name="passport_data"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnosis History">
                            <field name="diagnosis_ids" readonly="1">
                                <tree create="false" delete="false">
                                    <field name="visit_date"/>
                                    <field name="doctor_id"/>
                                    <field name="disease_id"/>
                                    <field name="treatment_description"/>
                                    <field name="is_approved"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Visits">
                            <field name="visit_ids" readonly="1">
                                <tree create="false" delete="false">
                                    <field name="visit_date"/>
                                    <field name="doctor_id"/>
                                    <field name="state"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_patient_view_search" model="ir.ui.view">
        <field name="name">hr.hospital.patient.view.search</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('phone', 'ilike', self)]"/>
                <field name="phone"/>
                <field name="doctor_id"/>
            </search>
        </field>
    </record>

    <record id="hr_hospital_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="hr_hospital_patient_view_search"/>
    </record>
</odoo>
