<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_hospital_disease_view_tree" model="ir.ui.view">
        <field name="name">hr.hospital.disease.view.tree</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="parent_id"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_disease_view_form" model="ir.ui.view">
        <field name="name">hr.hospital.disease.view.form</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <form string="Disease">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="parent_id"/>
                    </group>
                    <notebook>
                        <page string="Subdiseases">
                            <field name="child_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="hr_hospital_disease_view_hierarchy" model="ir.ui.view">
        <field name="name">hr.hospital.disease.view.hierarchy</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <hierarchy parent_field="parent_id"
                       child_field="child_ids"
                       draggable="false">
                <field name="parent_id" invisible="1"/>
                <field name="child_ids" invisible="1"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div class="o_hierarchy_node_header p-3">
                            <strong>
                                <field name="name"/>
                            </strong>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>
    <record id="hr_hospital_disease_action" model="ir.actions.act_window">
        <field name="name">Diseases</field>
        <field name="res_model">hr.hospital.disease</field>
        <field name="view_mode">hierarchy,tree,form</field>
    </record>
</odoo>
